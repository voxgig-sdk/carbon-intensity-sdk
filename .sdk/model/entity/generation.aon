# Entity: generation

main: kit: entity: generation: {

  alias: field: {}

  fields: [
    {
      name: "data"
      req: false
      type: "`$ARRAY`"
    }
    {
      format: "date-time"
      name: "from"
      req: false
      type: "`$STRING`"
    }
    {
      name: "generationmix"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "to"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    from: {
      from: "from"
      to: "to"
    }
    name: "id"
    parts: [
      "from"
      "to"
    ]
    sep: "/"
  }

  name: "generation"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/generation"
          segments: [
            {
              lit: "generation"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "from"
                orig: "from"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "to"
                orig: "to"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/generation/{from}/{to}"
          segments: [
            {
              lit: "generation"
            }
            {
              var: "from"
            }
            {
              var: "to"
            }
          ]
          select: {
            exist: [
              "from"
              "to"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
