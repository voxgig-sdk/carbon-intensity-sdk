# Entity: intensity

main: kit: entity: intensity: {

  alias: field: {}

  fields: [
    {
      name: "data"
      req: false
      type: "`$ARRAY`"
    }
    {
      format: "date-time"
      name: "from"
      req: false
      short: "Start datetime of the period"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "intensity"
      req: false
      type: "`$OBJECT`"
    }
    {
      format: "date-time"
      name: "to"
      req: false
      short: "End datetime of the period"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "intensity"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/intensity"
          segments: [
            {
              lit: "intensity"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "date"
                orig: "date"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "period"
                orig: "period"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/intensity/date/{date}/{period}"
          segments: [
            {
              lit: "intensity"
            }
            {
              lit: "date"
            }
            {
              var: "date"
            }
            {
              var: "period"
            }
          ]
          select: {
            exist: [
              "date"
              "period"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "from"
                orig: "from"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "to"
                orig: "to"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/intensity/{from}/{to}"
          segments: [
            {
              lit: "intensity"
            }
            {
              var: "from"
            }
            {
              var: "to"
            }
          ]
          select: {
            exist: [
              "from"
              "to"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "from"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/intensity/{from}"
          rename: {
            param: {
              from: "id"
            }
          }
          segments: [
            {
              lit: "intensity"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "date"
      ]
      [
        "intensity"
      ]
    ]
  }



}
